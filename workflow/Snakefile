from pathlib import Path


# The configuration file
configfile: "workflow/config.yaml"

# The config/static configuration for the experiment.
DATASET_PATH = Path(config["dataset"])
RESULT_PATH = Path(config["result_dir"])
LOG_PATH = Path(config["log_dir"])

ANONYMIZATIONS = config["anonymization_methods"]
FRAME_EMBEDDINGS = config["frame_embedding_methods"]
VIDEO_EMBEDDINGS = config["video_embedding_methods"]
VIDEO_AGGREGATORS = config["video_aggregation_methods"]
IDENTITY_AGGREGATORS = config["identity_aggregation_methods"]

SPLIT_K = int(config["split_k"])
SPLIT_SHUFFLE = bool(config["split_shuffle"])


# Anonymizes the dataset for each anonymization method. It takes the dataset as input and generates a
# equally structured dataset file but with the frame paths now pointing to the anonymized variants.
# Input Format: **, path (str)
# Output Format: **, path (str)
rule anonymize_frame:
    input:
        dataset=DATASET_PATH,
    output:
        dataset=RESULT_PATH / "anonymize_frame/{frame_anonymization}/structure.parquet",
    # There are only as many jobs here as there are anonymization methods, so per-job threads
    # are the only way to use the whole machine. The scripts pass this budget on to OpenCV and
    # ONNX Runtime, both of which would otherwise each grab every core and contend.
    threads: 3
    log: LOG_PATH / "anonymize_frame/{frame_anonymization}.log"
    script: "scripts/anonymize_frame.py"


# TODO use round robin so that fold 1 does not always get more videos (dont reset after identity)
# Splits the dataset for k-fold cross validation. It takes the dataset as input and generates a structure
# file in which each identity-video is assigned a 'fold' (1 to k). This step is split such that altering the
# splits does not trigger a re-run of the anonymize and (partial) aggregation rules. Only those that actually
# use the split information. The output holds one row per identity-video (not per frame), so that merging it
# onto a structure never duplicates rows.
# Input Format: **, identity (str), video (str)
# Output Format: identity (str), video (str), fold (int)
rule split:
    input:
        dataset=DATASET_PATH,
    output:
        dataset=RESULT_PATH / "split/structure.parquet",
    params:
        k=SPLIT_K,
        shuffle=SPLIT_SHUFFLE,
    log: LOG_PATH / "split/general.log"
    script: "scripts/k_split.py"


# Embeds each video of the dataset adding the embedding to the dataset structure. Each embedding method has
# its own embedding dimensionality.
# Input Format: **, path (str)
# Output Format: **, embedding (float[])
rule embed_video:
    input:
        dataset=RESULT_PATH / "anonymize_frame/{frame_anonymization}/structure.parquet",
    output:
        dataset=RESULT_PATH / "embed_video/{frame_anonymization}/{video_embedding}/structure.parquet",
    log: LOG_PATH / "embed_video/{frame_anonymization}/{video_embedding}.log"
    script: "scripts/embed_video.py"


# Embeds each frame of the dataset adding the embedding to the dataset structure. Each embedding method has
# its own embedding dimensionality. The frame paths are also updated according to the new relative output path.
# Input Format: **, path (str)
# Output Format: **, path (str), embedding (float[])
rule embed_frame:
    input:
        dataset=RESULT_PATH / "anonymize_frame/{frame_anonymization}/structure.parquet",
    output:
        dataset=RESULT_PATH / "embed_frame/{frame_anonymization}/{frame_embedding}/structure.parquet",
    threads: 4
    log: LOG_PATH / "embed_frame/{frame_anonymization}/{frame_embedding}.log"
    script: "scripts/embed_frame.py"


# Aggregates all frame embeddings of an identity-video into one or more (aggregated) embeddings. This removes the frame
# reference as multiple frames are potentially combined into one. The frame embedder is able to use the original frame
# information to substitute additional information (e.g., the frame image quality).
# Input Format: **, path (str), embedding (float[])
# Output Format: **, embedding (float[])
rule aggregate_video:
    input:
        dataset=RESULT_PATH / "embed_frame/{frame_anonymization}/{frame_embedding}/structure.parquet",
    output:
        dataset=RESULT_PATH / "aggregate_video/{frame_anonymization}/{frame_embedding}/{video_aggregation}/structure.parquet",
    log: LOG_PATH / "aggregate_video/{frame_anonymization}/{frame_embedding}/{video_aggregation}.log"
    script: "scripts/aggregate_video.py"


# Aggregates all video embeddings of an identity into one or more (aggregated) embeddings. This removes the video reference
# as multiple videos are potentially combined into one. This takes the output from 'aggregate_video' (frame-wise embedding).
# One gallery is built per held-out fold: the rows tagged fold=f aggregate every video of an identity *except* those in
# fold f, which are the queries 'score' uses for that fold. 'fold' therefore names the held-out fold, not the fold the
# aggregated videos belong to.
# Input Format (dataset): **, identity (str), video (str), embedding (float[])
# Input Format (k_split): identity (str), video (str), fold (int)
# Output Format: identity (str), fold (int), embedding (float[])
rule aggregate_frame_identity:
    input:
        dataset=RESULT_PATH / "aggregate_video/{frame_anonymization}/{frame_embedding}/{video_aggregation}/structure.parquet",
        k_split=RESULT_PATH / "split/structure.parquet",
    output:
        dataset=RESULT_PATH / "aggregate_frame_identity/{frame_anonymization}/{frame_embedding}/{video_aggregation}/{identity_aggregation}/structure.parquet",
    log: LOG_PATH / "aggregate_frame_identity/{frame_anonymization}/{frame_embedding}/{video_aggregation}/{identity_aggregation}.log"
    script: "scripts/aggregate_identity.py"


# Same as 'aggregate_frame_identity', but for the (video-embedding) branch that skips per-frame aggregation
# entirely and embeds whole videos directly. Shares its script with 'aggregate_frame_identity'; only the
# wildcard shape differs (no {video_aggregation} segment, since there was never a per-video aggregation step).
use rule aggregate_frame_identity as aggregate_video_identity with:
    input:
        dataset=RESULT_PATH / "embed_video/{frame_anonymization}/{video_embedding}/structure.parquet",
        k_split=RESULT_PATH / "split/structure.parquet",
    output:
        dataset=RESULT_PATH / "aggregate_video_identity/{frame_anonymization}/{video_embedding}/{identity_aggregation}/structure.parquet",
    log: LOG_PATH / "aggregate_video_identity/{frame_anonymization}/{video_embedding}/{identity_aggregation}.log"


# Scores the recognition accuracy for each fold. It uses the identity aggregation as the gallery (train) and the video
# aggregation as the query (test). Fold f queries the videos of fold f against the gallery built from the other k-1 folds,
# so both sides are selected on the same 'fold' value.
# Also injects the wildcard combination into the score to be trackable.
# Input (train_dataset): identity (str), embedding (float[]), fold (int)
# Input (test_dataset): identity (str), video (str), embedding (float[])
# Input (k_split): identity (str), video (str), fold (int)
# Output: fold (int), top-1 (float), ..., frame_anonymization (str),  frame_embedding/video_embedding (str),  video_aggregation/video_embedding (str),  identity_aggregation (str)
rule score_frame:
    input:
        train_dataset=RESULT_PATH / "aggregate_frame_identity/{frame_anonymization}/{frame_embedding}/{video_aggregation}/{identity_aggregation}/structure.parquet",
        test_dataset=RESULT_PATH / "aggregate_video/{frame_anonymization}/{frame_embedding}/{video_aggregation}/structure.parquet",
        k_split=RESULT_PATH / "split/structure.parquet",
    output:
        dataset=RESULT_PATH / "score_frame/{frame_anonymization}/{frame_embedding}/{video_aggregation}/{identity_aggregation}/structure.parquet",
    log: LOG_PATH / "score_frame/{frame_anonymization}/{frame_embedding}/{video_aggregation}/{identity_aggregation}.log"
    script: "scripts/score.py"


# Same as 'score_frame', but for the video-embedding branch. Shares its script with 'score_frame'; only the
# wildcard shape differs (no {video_aggregation} segment).
use rule score_frame as score_video with:
    input:
        train_dataset=RESULT_PATH / "aggregate_video_identity/{frame_anonymization}/{video_embedding}/{identity_aggregation}/structure.parquet",
        test_dataset=RESULT_PATH / "embed_video/{frame_anonymization}/{video_embedding}/structure.parquet",
        k_split=RESULT_PATH / "split/structure.parquet",
    output:
        dataset=RESULT_PATH / "score_video/{frame_anonymization}/{video_embedding}/{identity_aggregation}/structure.parquet",
    log: LOG_PATH / "score_video/{frame_anonymization}/{video_embedding}/{identity_aggregation}.log"


# Gathers every score_frame and score_video result produced across the full parameter grid and concatenates
# them into one comparison table. This is a genuine union (not a branch selection): a run that varies
# {frame_embedding} x {video_aggregation} and a run that varies {video_embedding} are different points in
# the same comparison, not alternate paths to the same answer, so both sets of rows belong in the output.
# Input (flatten(*)): ...
# Output: pipeline (str), ...
rule collect_recognition:
    input:
        frame=expand(
            RESULT_PATH / "score_frame/{frame_anonymization}/{frame_embedding}/{video_aggregation}/{identity_aggregation}/structure.parquet",
            frame_anonymization=ANONYMIZATIONS,
            frame_embedding=FRAME_EMBEDDINGS,
            video_aggregation=VIDEO_AGGREGATORS,
            identity_aggregation=IDENTITY_AGGREGATORS,
        ),
        video=expand(
            RESULT_PATH / "score_video/{frame_anonymization}/{video_embedding}/{identity_aggregation}/structure.parquet",
            frame_anonymization=ANONYMIZATIONS,
            video_embedding=VIDEO_EMBEDDINGS,
            identity_aggregation=IDENTITY_AGGREGATORS,
        ),
    output:
        dataset=RESULT_PATH / "collect/recognition.parquet",
    log: LOG_PATH / "collect/recognition.log"
    script: "scripts/collect.py"

# Scores the clustering for each fold. It is applied on the identity aggregation as it natively includes the video_aggregation
# results as the `none` variant.
# Input (dataset): identity (str), embedding (float[]), fold (int)
# Output: fold (int), silhouette_avg (float), ..., frame_anonymization (str),  frame_embedding/video_embedding (str),  video_aggregation/video_embedding (str),  identity_aggregation (str)
rule score_frame_cluster:
    input:
        dataset=RESULT_PATH / "aggregate_frame_identity/{frame_anonymization}/{frame_embedding}/{video_aggregation}/{identity_aggregation}/structure.parquet",
    output:
        dataset=RESULT_PATH / "score_frame_cluster/{frame_anonymization}/{frame_embedding}/{video_aggregation}/{identity_aggregation}/structure.parquet",
    log: LOG_PATH / "score_frame_cluster/{frame_anonymization}/{frame_embedding}/{video_aggregation}/{identity_aggregation}.log"
    script: "scripts/score_cluster.py"


# Same as 'score_frame_cluster', but for the video-embedding branch. Shares its script with 'score_frame_cluster'; only
# the wildcard shape differs (no {video_aggregation} segment).
use rule score_frame_cluster as score_video_cluster with:
    input:
        dataset=RESULT_PATH / "aggregate_video_identity/{frame_anonymization}/{video_embedding}/{identity_aggregation}/structure.parquet",
    output:
        dataset=RESULT_PATH / "score_video_cluster/{frame_anonymization}/{video_embedding}/{identity_aggregation}/structure.parquet",
    log: LOG_PATH / "score_video_cluster/{frame_anonymization}/{video_embedding}/{identity_aggregation}.log"


# Gathers every score_frame_cluster and score_video_cluster result produced across the full parameter grid and concatenates
# them into one comparison table. This is a genuine union (not a branch selection): a run that varies
# {frame_embedding} x {video_aggregation} and a run that varies {video_embedding} are different points in
# the same comparison, not alternate paths to the same answer, so both sets of rows belong in the output.
# Input (flatten(*)): ...
# Output: pipeline (str), ...
rule collect_clustering:
    input:
        frame=expand(
            RESULT_PATH / "score_frame_cluster/{frame_anonymization}/{frame_embedding}/{video_aggregation}/{identity_aggregation}/structure.parquet",
            frame_anonymization=ANONYMIZATIONS,
            frame_embedding=FRAME_EMBEDDINGS,
            video_aggregation=VIDEO_AGGREGATORS,
            identity_aggregation=IDENTITY_AGGREGATORS,
        ),
        video=expand(
            RESULT_PATH / "score_video_cluster/{frame_anonymization}/{video_embedding}/{identity_aggregation}/structure.parquet",
            frame_anonymization=ANONYMIZATIONS,
            video_embedding=VIDEO_EMBEDDINGS,
            identity_aggregation=IDENTITY_AGGREGATORS,
        ),
    output:
        dataset=RESULT_PATH / "collect/clustering.parquet",
    log: LOG_PATH / "collect/clustering.log"
    script: "scripts/collect.py"


rule all:
    default_target: True
    input:
        recognition=RESULT_PATH / "collect/recognition.parquet",
        clustering=RESULT_PATH / "collect/clustering.parquet",
