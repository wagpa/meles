from pathlib import Path

configfile: "workflow/config.yaml"

# The dynamic configuration as provided by the configuration file.
input_dataset = Path(config["input_dataset"])
results_dir = Path(config["results_directory"])
anonymization_methods = config["anonymization_methods"]
embedding_methods = config["embedding_methods"]
aggregation_methods = config["aggregation_methods"]
k = int(config["k_folds"])

# The file path patterns for the snakemake rules.
anonymized_pattern = results_dir / "anonymize/{anonymization_method}/structure.parquet"
embedding_pattern = results_dir / "embedding/{anonymization_method}/{embedding_method}/embeddings.parquet"
k_fold_pattern = results_dir / "k_fold/{anonymization_method}/{embedding_method}/split-{k}.parquet"
aggregated_train_pattern = results_dir / "aggregation/{anonymization_method}/{embedding_method}/{aggregation_method}/split-{k}-train.parquet"
aggregated_test_pattern = results_dir / "aggregation/{anonymization_method}/{embedding_method}/{aggregation_method}/split-{k}-test.parquet"
score_pattern = results_dir / "scoring/{anonymization_method}/{embedding_method}/{aggregation_method}/scores.parquet"


# The anonymization rule applies parametrized anonymization to the input frames. It takes a structure file as input, applying
# the anonymization to each listed frame and stores them in another directory. The result is a new structure file with the
# new paths.
rule anonymize:
    input:
        input_dataset
    output:
        anonymized_pattern
    threads: 1
    shell:
        "python workflow/scripts/anonymize.py "
        "--input {input:q} "
        "--output {output:q} "
        "--method {wildcards.anonymization_method}"

# The embed rule embeds each frame based on a parametrized method. It attaches the colum "embedding" to the dataset rows.
rule embed:
    input:
        anonymized_pattern
    output:
        embedding_pattern
    threads: 4
    shell:
        "python workflow/scripts/embedding.py "
        "--input {input:q} "
        "--output {output:q} "
        "--method {wildcards.embedding_method}"

# The train-test-split rule splits the dataset using k-fold cross-validation. It attaches the column "train" to the dataset
# where 'True' assigns a frame to the trainset. The output consists of multiple files, one for each k-fold with the described
# assignments.
rule test_train_split:
    input:
        embedding_pattern
    output:
        expand(k_fold_pattern, k=range(k), allow_missing=True)
    params:
        k=k
    shell:
        "python workflow/scripts/k_fold_splitting.py "
        "--input {input:q} "
        "{output:q} "

# The aggregate rule aggregates the embeddings based on a parametrized method. The train output consists of one or more
# embeddings for each identity (drops video and frame level columns), the test output has one for each video (drops frame
# level columns).
rule aggregate:
    input:
        k_fold_pattern
    output:
        train = aggregated_train_pattern,
        test = aggregated_test_pattern,
    shell:
        "python workflow/scripts/aggregate.py "
        "--input {input:q} "
        "--train-output {output.train:q} "
        "--test-output {output.test:q} "
        "--method {wildcards.aggregation_method}"

# The score rule scores the train and test datasets for each k-fold. The output dataframe consists of multiple metrics.
rule score:
    input:
        train_sets = expand(aggregated_train_pattern, k=range(k), allow_missing=True),
        test_sets = expand(aggregated_test_pattern, k=range(k), allow_missing=True)
    output:
        score_pattern
    params:
        train_args = lambda wildcards, input: " ".join(f"--train-set '{path}'" for path in input.train_sets),
        test_args = lambda wildcards, input: " ".join(f"--test-set '{path}'" for path in input.test_sets)
    shell:
        "python workflow/scripts/score.py "
        "{params.train_args} "
        "{params.test_args} "
        "--method {wildcards.aggregation_method} "
        "--output {output:q}"


# This rule triggers the experiment for all combinations.
rule all:
    default_target: True
    input:
        expand(
            score_pattern,
            anonymization_method=anonymization_methods,
            embedding_method=embedding_methods,
            aggregation_method=aggregation_methods
        )
